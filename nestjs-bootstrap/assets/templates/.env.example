# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
APP_PORT=3000
FE_HOST=http://localhost:3001

# Prisma / PostgreSQL (host-side URL for the CLI and the app)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{PROJECT_NAME}}

# Used by docker-compose for the postgres service
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB={{PROJECT_NAME}}

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT — 32+ random characters, access and refresh MUST differ
JWT_TOKEN_SECRET=replace-with-a-random-32-plus-character-secret
JWT_TOKEN_EXPIRATION_TIME=15m
JWT_REFRESH_TOKEN_SECRET=replace-with-another-random-32-plus-character-secret
JWT_REFRESH_TOKEN_EXPIRATION_TIME=7d
