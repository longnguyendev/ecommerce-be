// ───────── Inventory ─────────
// ProductVariant.stockQuantity là số tồn hiện tại (cache đọc nhanh). Mọi thay đổi
// phải đi qua InventoryService.applyMovement để có dòng StockMovement tương ứng.

enum StockMovementType {
  RECEIPT // nhập hàng theo phiếu
  ADJUSTMENT // kiểm kho / điều chỉnh tay (có lý do)
  ORDER // trừ kho khi tạo đơn
  ORDER_CANCEL // hoàn kho khi huỷ đơn
  RECEIPT_REVERT // hoàn phiếu nhập về nháp: trừ lại số đã nhập
}

enum ReceiptStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model StockMovement {
  id           String            @id @default(uuid())
  variantId    String
  variant      ProductVariant    @relation(fields: [variantId], references: [id])
  type         StockMovementType
  quantity     Int // có dấu: + nhập / - xuất
  balanceAfter Int // tồn sau khi áp dụng
  unitCost     Int? // VND, chỉ có với RECEIPT
  reason       String?
  receiptId    String?
  receipt      PurchaseReceipt?  @relation(fields: [receiptId], references: [id])
  orderId      String?
  order        Order?            @relation(fields: [orderId], references: [id])
  createdById  String?
  createdAt    DateTime          @default(now())

  @@index([variantId, createdAt])
  @@index([receiptId])
  @@index([orderId])
  @@index([type, createdAt])
}

model PurchaseReceipt {
  id          String                @id @default(uuid())
  code        String                @unique // PN2606010001
  note        String?
  status      ReceiptStatus         @default(DRAFT)
  confirmedAt DateTime?
  createdById String?
  items       PurchaseReceiptItem[]
  movements   StockMovement[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([status, createdAt])
}

model PurchaseReceiptItem {
  id         String          @id @default(uuid())
  receiptId  String
  receipt    PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant  @relation(fields: [variantId], references: [id])
  quantity   Int // CHECK (> 0) trong migration SQL
  unitCost   Int // VND giá nhập / đơn vị
  costBefore Int? // giá vốn biến thể ngay trước khi xác nhận (để hoàn lại)

  @@index([receiptId])
  @@index([variantId])
}
